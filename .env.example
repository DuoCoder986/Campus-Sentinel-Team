# Local demonstration only. Replace before any public deployment.
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://campus:replace-with-a-long-random-local-password@localhost:5432/campus
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-different-long-local-password
NEO4J_URI=bolt://localhost:7687
EMBEDDING_URL=http://localhost:8000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Required only by seed; never commit actual values.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_REPORTER_PASSWORD=
COOKIE_SECURE=false
